From: Daniel Golle <daniel@makrotopia.org>
Subject: [PATCH] hwrng: rockchip: add rv1126 support

Adapt RV1126 support to ImmortalWrt's Rockchip RNG driver overlay.
The RV1126 register window starts at the RNG control register, so use
crypto v2 operations with zero offset. This driver does not pulse reset
lines, preserving the block shared with the secure world.

Keep the legacy compatible strings and entropy quality for existing SoCs.
Use the upstream RV1126 quality value of 900 for the new compatible.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
--- a/drivers/char/hw_random/rockchip-rng.c
+++ b/drivers/char/hw_random/rockchip-rng.c
@@ -110,6 +110,7 @@
 
 struct rk_rng_soc_data {
 	u32 default_offset;
+	unsigned short quality;
 
 	int (*rk_rng_init)(struct hwrng *rng);
 	int (*rk_rng_read)(struct hwrng *rng, void *buf, size_t max, bool wait);
@@ -419,6 +420,15 @@
 	.rk_rng_read = crypto_v2_read,
 };
 
+/* RV1126 maps the RNG registers directly and shares the block with firmware.
+ * Reuse the crypto v2 operations without an additional offset or reset.
+ */
+static const struct rk_rng_soc_data rv1126_soc_data = {
+	.default_offset = 0,
+	.quality = 900,
+	.rk_rng_read = crypto_v2_read,
+};
+
 static const struct rk_rng_soc_data trng_v1_soc_data = {
 	.default_offset = 0,
 
@@ -434,6 +444,10 @@
 };
 
 static const struct of_device_id rk_rng_dt_match[] = {
+	{
+		.compatible = "rockchip,rv1126-rng",
+		.data = (void *)&rv1126_soc_data,
+	},
 	{
 		.compatible = "rockchip,cryptov1-rng",
 		.data = (void *)&crypto_v1_soc_data,
@@ -478,7 +492,7 @@
 	rk_rng->rng.cleanup = rk_rng_cleanup,
 #endif
 	rk_rng->rng.read    = rk_rng_read;
-	rk_rng->rng.quality = 999;
+	rk_rng->rng.quality = rk_rng->soc_data->quality ?: 999;
 
 	rk_rng->mem = devm_of_iomap(&pdev->dev, pdev->dev.of_node, 0, &map_size);
 	if (IS_ERR(rk_rng->mem))
